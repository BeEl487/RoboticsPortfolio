---
import { ClientRouter } from "astro:transitions";
import { NAME, GITHUB, YOUTUBE } from "../data/pages.mjs";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: "work";
}
const { title, description, current } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..650;1,8..60,400&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" transition:persist>
      <a class="brand" href="/">{NAME}</a>
      <nav aria-label="Main">
        <a href="/#work" aria-current={current === "work" ? "page" : undefined}>Work</a>
        <a href="/#profile">Profile</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>{NAME} · Sydney</span>
      <a href={GITHUB}>GitHub</a>
      <a href={YOUTUBE}>YouTube</a>
    </footer>
  </body>
</html>
